# Copy to .env and fill in. The real .env is ignored by git.
# Django does not read this file by itself: export the variables in your shell
# or pass the file to Docker with --env-file.

# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# 1 only for local development. Leave unset (or 0) in production.
DJANGO_DEBUG=0

# Comma-separated, e.g. example.org,www.example.org
DJANGO_ALLOWED_HOSTS=
